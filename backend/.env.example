# Required for signing one-hour JWT access tokens. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-generated-locally

# Resume analysis integrations
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# Comma-separated browser origins allowed to call the API directly.
CAREERLYST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
